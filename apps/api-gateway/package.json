{
  "name": "@brain/api-gateway",
  "private": true,
  "version": "0.0.0",
  "description": "BFF: tRPC for web+mobile, auth/multi-tenancy/rate-limit choke point, gRPC fan-out. No business logic, no AI orchestration.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "dev": "tsx --env-file=.env src/interfaces/server.ts"
  },
  "dependencies": {
    "@brain/lib-logger": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.15",
    "@trpc/server": "^11.1.2",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
