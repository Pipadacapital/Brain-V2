# apps/api-gateway/.env.example — KEY NAMES ONLY. Safe to commit. NO VALUES.
# Copy to apps/api-gateway/.env (git-ignored) and fill local-dev values.
#
# Slice A (feat-auth-supabase-identity): real Supabase JWT verification.
# SECURITY: the gateway is client-facing — it uses the ANON key for JWKS verify.
# The Supabase SERVICE-ROLE key MUST NEVER live here.

# Supabase project URL — used to build the JWKS URL, issuer, and audience.
SUPABASE_URL=

# Supabase anon (publishable) key. Anon ONLY — never the service-role key.
SUPABASE_ANON_KEY=

# Server-side LOCAL harness flag. Absent/"false" = real-auth (default).
# "true" enables the offline stub-auth path (LOCAL DEV ONLY; fatal under
# NODE_ENV=production).
BRAIN_GATEWAY_LOCAL_HARNESS=

# Gateway listen port (defaults to 3001 if unset).
GATEWAY_PORT=

# Slice C (feat-onboarding-membership-db): LOCAL dev Postgres (docker) connection.
# Brain-native RLS schema for onboarding/membership. Session-mode (:5432) DIRECT
# connection. Connect as the NON-BYPASSRLS app role (rls_app) so FORCE RLS applies.
# This is the LOCAL dev DB — NOT the live shared Supabase production DB.
# Example shape (fill in apps/api-gateway/.env, git-ignored):
#   DATABASE_URL=postgresql://rls_app:rls_app_pw@localhost:5432/brain_dev
DATABASE_URL=

# ---------------------------------------------------------------------------
# Slice D (feat live integrations OAuth + token custody) — KEY NAMES ONLY.
# Copy the real OAuth client ids/secrets from legacy project/backend/.env into
# apps/api-gateway/.env (git-ignored). NEVER commit a value.
# ---------------------------------------------------------------------------

# Token-custody at-rest (LOCAL DEV). Backing selector + the AES-256-GCM key.
#   CONNECTOR_CUSTODY_BACKING=local-aesgcm   (any production name -> HELD stub, throws)
#   CONNECTOR_CUSTODY_KEY = 32-byte base64 key. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The PRODUCTION at-rest custody decision (AWS Secrets Manager ap-south-1 vs
# Supabase encrypt-in-place) is HELD (CF-C7-CUSTODY-PROOF-1) — do NOT enable here.
CONNECTOR_CUSTODY_BACKING=
CONNECTOR_CUSTODY_KEY=

# Shopify (per-store OAuth). Client id/secret from the Shopify Partner app.
# REGISTER this redirect in the Partner dashboard (Allowed redirection URL(s)):
#   http://localhost:3000/api/integrations/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=

# Meta Ads. App id/secret + optional config id from the Meta App dashboard.
# REGISTER this redirect (Facebook Login -> Valid OAuth Redirect URIs):
#   http://localhost:3000/api/integrations/meta/callback
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_API_VERSION=
META_REDIRECT_URI=

# Google Ads. Client id/secret + developer token + (optional MCC) login customer id.
# REGISTER this redirect (Google Cloud Console -> Authorized redirect URIs):
#   http://localhost:3000/api/integrations/google/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_REDIRECT_URI=

# Public web app origin (used in callback redirects).
NEXT_PUBLIC_APP_URL=
