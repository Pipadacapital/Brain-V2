# apps/api-gateway/.env.example — KEY NAMES ONLY. Safe to commit. NO VALUES.
# Copy to apps/api-gateway/.env (git-ignored) and fill local-dev values.
#
# Slice A (feat-auth-supabase-identity): real Supabase JWT verification.
# SECURITY: the gateway is client-facing — it uses the ANON key for JWKS verify.
# The Supabase SERVICE-ROLE key MUST NEVER live here.

# Supabase project URL — used to build the JWKS URL, issuer, and audience.
SUPABASE_URL=

# Supabase anon (publishable) key. Anon ONLY — never the service-role key.
SUPABASE_ANON_KEY=

# Server-side LOCAL harness flag. Absent/"false" = real-auth (default).
# "true" enables the offline stub-auth path (LOCAL DEV ONLY; fatal under
# NODE_ENV=production).
BRAIN_GATEWAY_LOCAL_HARNESS=

# Gateway listen port (defaults to 3001 if unset).
GATEWAY_PORT=

# Slice C (feat-onboarding-membership-db): LOCAL dev Postgres (docker) connection.
# Brain-native RLS schema for onboarding/membership. Session-mode (:5432) DIRECT
# connection. Connect as the NON-BYPASSRLS app role (rls_app) so FORCE RLS applies.
# This is the LOCAL dev DB — NOT the live shared Supabase production DB.
# Example shape (fill in apps/api-gateway/.env, git-ignored):
#   DATABASE_URL=postgresql://rls_app:rls_app_pw@localhost:5432/brain_dev
DATABASE_URL=
