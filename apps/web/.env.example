# apps/web/.env.example — KEY NAMES ONLY. Safe to commit. NO VALUES.
# Copy to apps/web/.env.local (git-ignored) and fill local-dev values.
#
# Slice A (feat-auth-supabase-identity): real Supabase identity in the browser.
# Only NEXT_PUBLIC_* keys are exposed to the client — all values here are
# publishable (anon/publishable key), never a secret/service-role key.

# Supabase project URL (client-side).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Publishable ONLY — never the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# api-gateway base URL (defaults to http://localhost:3001 if unset).
NEXT_PUBLIC_API_URL=

# Client LOCAL harness flag. "true" enables the offline stub login + sends the
# harness x-workspace-id header (the server IGNORES it on the real-auth path).
# Absent/"false" = real Supabase auth (default).
NEXT_PUBLIC_BRAIN_LOCAL_HARNESS=
