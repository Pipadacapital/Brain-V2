# apps/core-service/.env.example — KEY NAMES ONLY. Safe to commit. NO VALUES.
# Copy to apps/core-service/.env (git-ignored) and fill local-dev values.
#
# Slice C (feat-onboarding-membership-db): the Brain-native session-context
# primitive (withWorkspace / withSuperadmin) connects to a session-mode (:5432)
# DIRECT Postgres connection. For LOCAL dev this is the docker brain_dev DB.
#
# Connect as the NON-BYPASSRLS application role (rls_app) so FORCE ROW LEVEL
# SECURITY actually applies. The postgres superuser is used ONLY for DDL/migrations.
#
# DIRECT_URL is the canonical key (Child-1); DATABASE_URL is an accepted ALIAS
# (slice C) — both must point at the SAME session-mode connection string.
# Example shape:
#   DATABASE_URL=postgresql://rls_app:rls_app_pw@localhost:5432/brain_dev
DATABASE_URL=
DIRECT_URL=
