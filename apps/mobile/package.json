{
  "name": "@brain/mobile",
  "private": true,
  "version": "0.0.0",
  "description": "Brain mobile (React Native + Expo). Morning Brief is THE primary product surface.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "npx tsc --noEmit",
    "typecheck": "npx tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern='__tests__' --passWithNoTests"
  },
  "dependencies": {
    "@brain/api-gateway": "workspace:*",
    "@brain/lib-metrics": "workspace:*",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^6.1.18",
    "@reduxjs/toolkit": "^2.5.1",
    "@tamagui/core": "^1.120.0",
    "@tamagui/theme-base": "^1.120.0",
    "@tamagui/toast": "^1.120.0",
    "@tanstack/react-query": "^5.64.1",
    "@trpc/client": "^11.1.2",
    "@trpc/react-query": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "expo": "~53.0.0",
    "expo-application": "~6.0.1",
    "expo-constants": "~17.0.3",
    "expo-device": "~7.0.1",
    "expo-linking": "~7.0.3",
    "expo-notifications": "~0.29.9",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "superjson": "^2.2.2",
    "tamagui": "^1.120.0",
    "victory-native": "^41.14.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "target": "ES2022",
            "strict": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@brain/lib-metrics$": "<rootDir>/../../packages/lib-metrics/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "extensionsToTreatAsEsm": []
  }
}
