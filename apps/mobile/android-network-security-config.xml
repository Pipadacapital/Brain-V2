<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Network Security Config for Brain.

  mobile-9 fix: placeholder SPKI pins (PLACEHOLDER_CURRENT_PIN / PLACEHOLDER_ROTATION_PIN)
  removed. Shipping placeholder values causes Android to reject ALL TLS connections to the
  domain on a real build (the pin never matches). The pin-set block must be restored with
  REAL SHA-256 SPKI fingerprints derived from the live TLS certificate before any
  production EAS build.

  Restore procedure (from docs/runbook-cert-pinning.md):
    1. Derive SPKI fingerprints:
         openssl s_client -connect brain.pipadacapital.com:443 | \
           openssl x509 -pubkey -noout | \
           openssl pkey -pubin -outform der | \
           openssl dgst -sha256 -binary | base64
    2. Add current pin + rotation pin to the <pin-set> below.
    3. OTA the new pin set ONE WEEK before server certificate rotation.
    4. Pin changes require a NATIVE bump (store review), NOT an OTA update.

  MASVS L1 + key L2: TLS + cert pinning required for production.
  cleartextTrafficPermitted=false enforced for all non-localhost domains.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">brain.pipadacapital.com</domain>
    <!--
      TODO (before production build): restore the pin-set block with real SPKI pins.
      Example structure (two pins: current + rotation):
        <pin-set expiration="2027-01-01">
          <pin digest="SHA-256">REAL_CURRENT_PIN_BASE64=</pin>
          <pin digest="SHA-256">REAL_ROTATION_PIN_BASE64=</pin>
        </pin-set>
    -->
  </domain-config>
  <!--
    Local dev harness: allow cleartext to localhost (Phase 0-1 only).
    NEVER ship cleartext to production domains.
  -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
  <base-config cleartextTrafficPermitted="false" />
</network-security-config>
