# Engineering OS internals (not product code)
.engineering-os/index/
.engineering-os/live.log
.engineering-os/dashboard.html
# Per-session agent spawn telemetry — regenerated every run, placeholder values
.engineering-os/spawn-heartbeat.jsonl
# State backups are local safety copies; git history is the real audit trail.
# Broad glob: catches active.json.bak, active.json.bak2.<ts>, active.json.bak.<ts>.
.engineering-os/state/*.bak*

# Secrets / env — NEVER commit. Local-dev credentials live only in untracked .env files.
.env
.env.*
!.env.example
!.env.docker.example
**/.env
**/.env.*
!**/.env.example
!**/.env.docker.example

# macOS
.DS_Store

# Node / pnpm
node_modules/
dist/
*.tsbuildinfo
.turbo/

# Generated TypeScript stubs (buf generate → regenerated in CI; see DECISIONS.md §3)
packages/lib-grpc-clients/gen/

# Python / uv
.venv/
__pycache__/
*.egg-info/
*.dist-info/
*.pyc

# Generated Python stubs (buf generate → regenerated in CI; see DECISIONS.md §3)
pylibs/proto_py/proto_py/_gen/

# Lockfiles are COMMITTED (not ignored) — pnpm-lock.yaml and uv.lock must be in git.
# Do NOT add pnpm-lock.yaml or uv.lock here.

# Next.js
.next/
!.next/cache/

# Build artifacts
build/
out/

# Test coverage byproducts (never commit)
coverage/
.coverage
*.lcov

graphify-out/manifest.json    # mtime-based, breaks after git clone
graphify-out/cost.json        # local only
# graphify-out/cache/         # optional: commit for speed, skip to keep repo small

legacy project
# AWS CDK synth output (regenerated by `cdk synth`)
cdk.out/

# Claude Code local config/state (settings.json, scheduled-task locks)
.claude/
