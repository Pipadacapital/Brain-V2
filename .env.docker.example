# =============================================================================
# .env.docker.example — KEY NAMES ONLY. Safe to commit. NO VALUES.
#
# Copy to .env.docker (gitignored) and fill the values from your existing
# apps/api-gateway/.env. The compose file reads .env.docker via `env_file`
# directives + ${VAR} shell expansion for the build-time NEXT_PUBLIC_* values.
#
# Boot:
#   cp .env.docker.example .env.docker
#   # …fill values…
#   docker compose --env-file .env.docker up -d --build
#
# Why --env-file: compose uses it for BOTH the ${VAR} build-time expansion
# of NEXT_PUBLIC_* args AND the runtime env_file injection. Without the flag
# compose reads from the host shell + a project-root .env, which we don't
# want to mix with the per-app apps/*/.env files.
#
# Browse:
#   web        → http://localhost:3000
#   api-gateway→ http://localhost:3001/health
#   postgres   → localhost:5432 (psql -U postgres -d brain_dev)
#   clickhouse → http://localhost:8123/ping
#
# Logs:
#   docker compose --env-file .env.docker logs -f api-gateway | jq
#   docker compose --env-file .env.docker logs -f web
# =============================================================================

# --- Logging ---
# debug | info | warn | error  (default: info)
LOG_LEVEL=

# --- Supabase identity (browser + server) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Connector custody (local AES-256-GCM dev backing) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_CUSTODY_BACKING=local-aesgcm
CONNECTOR_CUSTODY_KEY=

# --- Shopify OAuth (per-store Partner app) ---
# Register: http://localhost:3000/api/integrations/shopify/callback in the Partner dashboard.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/integrations/shopify/callback

# --- Meta Ads OAuth (Facebook Login → Valid OAuth Redirect URIs) ---
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_API_VERSION=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback

# --- Google Ads OAuth (Google Cloud Console → Authorized redirect URIs) ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
